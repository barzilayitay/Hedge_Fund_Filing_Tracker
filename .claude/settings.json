{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/run-tests.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(vercel --prod:*)",
      "Bash(git push --force:*)",
      "Read(.env)"
    ]
  }
}
