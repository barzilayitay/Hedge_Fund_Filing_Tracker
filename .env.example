# EDGAR fair-access header (required)
# Format: "AppName contact@email.com"
EDGAR_USER_AGENT="HedgeFundFilingTracker your-email@example.com"

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection for the loader/export/seed scripts (needs `npm i pg`).
# `npm run seed` refuses any host other than localhost/127.0.0.1 unless run with
# --i-know-what-im-doing, so keep this pointed at your local database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# OpenFIGI API (required for CUSIP→ticker mapping)
OPENFIGI_API_KEY=your-openfigi-api-key

# Vercel (Phase 7 only)
# VERCEL_TOKEN=your-vercel-token
